{
  "name": "@babylonjsmarket/arcade",
  "version": "0.13.0",
  "type": "module",
  "license": "MIT",
  "description": "The game runner for @babylonjsmarket/ecs: ArcadeGame (scene JSON in, running game out), the controls HUD, shared event names, and the `arcade` project scaffolder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babylonjsmarket/arcade.git"
  },
  "author": "BabylonJS Market",
  "bin": {
    "arcade": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viz": {
      "types": "./src/viz.ts",
      "import": "./src/viz.ts"
    },
    "./cli": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/viz.ts",
    "src/ControlsHud.ts",
    "src/events.ts",
    "src/inputEvents.ts",
    "templates",
    ".claude-payload",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "sync-templates": "node scripts/sync-templates.js",
    "sync-templates:check": "node scripts/sync-templates.js --check",
    "try:scaffold": "node scripts/try-scaffold.mjs",
    "validate:scenes": "tsx scripts/validate-example-scenes.ts",
    "validate:course-scenes": "tsx scripts/validate-course-scenes.ts",
    "validate:scenes:all": "npm run validate:scenes && npm run validate:course-scenes",
    "prepublishOnly": "npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@babylonjsmarket/ecs": "^0.9.9",
    "@clack/prompts": "^0.10.0",
    "earcut": "^3.2.3",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@babylonjs/core": "*",
    "@babylonjsmarket/viz": "*",
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@babylonjsmarket/viz": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjsmarket/eslint-plugin": "*",
    "@babylonjsmarket/viz": "*",
    "@solidjs/testing-library": "^0.8.10",
    "@types/earcut": "^3.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.3.0",
    "memfs": "^4.36.0",
    "solid-js": "^1.9.3",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.0.0"
  }
}

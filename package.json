{
  "name": "@babylonjsmarket/arcade",
  "version": "0.3.4",
  "type": "module",
  "license": "MIT",
  "description": "Reusable arcade-style components (mesh, camera, lights, input, physics, scoring, animation) for the @babylonjsmarket/ecs framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babylonjsmarket/arcade.git"
  },
  "author": "BabylonJS Market",
  "bin": {
    "arcade": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viz": {
      "types": "./src/viz.ts",
      "import": "./src/viz.ts"
    },
    "./cli": "./dist/cli/index.js",
    "./package.json": "./package.json",
    "./MeshPrimitive": "./dist/Components/MeshPrimitive/MeshPrimitive.js",
    "./Movement": "./dist/Components/Movement/Movement.js",
    "./KeyboardMover": "./dist/Components/KeyboardMover/KeyboardMover.js",
    "./PlayerInput": "./dist/Components/PlayerInput/PlayerInput.js",
    "./ArcCamera": "./dist/Components/ArcCamera/ArcCamera.js",
    "./CameraFollow": "./dist/Components/CameraFollow/CameraFollow.js",
    "./DirectionalLight": "./dist/Components/DirectionalLight/DirectionalLight.js",
    "./HemisphericLight": "./dist/Components/HemisphericLight/HemisphericLight.js",
    "./Physics": "./dist/Components/Physics/Physics.js",
    "./Score": "./dist/Components/Score/Score.js",
    "./Scoreboard": "./dist/Components/Scoreboard/Scoreboard.js",
    "./Health": "./dist/Components/Health/Health.js",
    "./HealthBar": "./dist/Components/HealthBar/HealthBar.js",
    "./Flash": "./dist/Components/Flash/Flash.js",
    "./Shadow": "./dist/Components/Shadow/Shadow.js",
    "./Skybox": "./dist/Components/Skybox/Skybox.js",
    "./EnvironmentTexture": "./dist/Components/EnvironmentTexture/EnvironmentTexture.js",
    "./Animation": "./dist/Components/Animation/Animation.js",
    "./Mesh": "./dist/Components/Mesh/Mesh.js",
    "./Plunger": "./dist/Components/Plunger/Plunger.js",
    "./PinballCamera": "./dist/Components/PinballCamera/PinballCamera.js",
    "./PinballLayout": "./dist/Components/PinballLayout/PinballLayout.js",
    "./PinballTable": "./dist/Components/PinballTable/PinballTable.js",
    "./PinballBuilder": "./dist/Components/PinballBuilder/PinballBuilder.js",
    "./PinballBuilderInput": "./dist/Components/PinballBuilderInput/PinballBuilderInput.js",
    "./Bumper": "./dist/Components/Bumper/Bumper.js",
    "./Flipper": "./dist/Components/Flipper/Flipper.js",
    "./MouseHole": "./dist/Components/MouseHole/MouseHole.js",
    "./Spinner": "./dist/Components/Spinner/Spinner.js",
    "./Bullet": "./dist/Components/Bullet/Bullet.js",
    "./Enemy": "./dist/Components/Enemy/Enemy.js",
    "./EnemySpawner": "./dist/Components/EnemySpawner/EnemySpawner.js",
    "./TwinStickShooter": "./dist/Components/TwinStickShooter/TwinStickShooter.js",
    "./ShooterCamera": "./dist/Components/ShooterCamera/ShooterCamera.js"
  },
  "files": [
    "dist",
    "src/viz.ts",
    "src/Components/**/*.ts",
    "src/Components/**/*.viz.tsx",
    "src/Components/**/*.panel.tsx",
    "src/Components/**/meta.json",
    "src/Components/_shared",
    "templates",
    ".claude-payload",
    ".claude-plugin",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "sync-templates": "node scripts/sync-templates.js",
    "sync-templates:check": "node scripts/sync-templates.js --check",
    "validate:scenes": "tsx scripts/validate-example-scenes.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@babylonjsmarket/ecs": "*",
    "@clack/prompts": "^0.10.0",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@babylonjsmarket/viz": "*",
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@babylonjsmarket/viz": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjsmarket/eslint-plugin": "*",
    "@babylonjsmarket/viz": "*",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.3.0",
    "memfs": "^4.36.0",
    "solid-js": "^1.9.3",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.0.0"
  }
}
